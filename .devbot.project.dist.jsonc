{
  "project_name": "__PROJECT_NAME__",
  "harness": "opencode",
  "devbot_dir": ".agents",
  // Workspace behaviour defaults live in .devbot.global.jsonc::workspace.
  // State a key here only when this project differs from those defaults:
  //   "workspace": { "type": "polyrepo", "commit_memory": true,
  //                  "workflow": "trunk" }
  // `type` is "repo" (the default) or "polyrepo" — a container project that
  // orchestrates the managed projects registered in the global `projects`
  // array, with memory scope resolved from the files the session touches.
  // Opt in BY NAME to datasources declared in .devbot.global.jsonc. Only these
  // are registered with this project's harness — the rest cost nothing, not
  // even context.
  "datasources": [],
  // Opt in BY NAME to clusters declared in .devbot.global.jsonc::kubectl.clusters.
  // The project gets its own ~/.kube/devbot/<project>.yaml; nothing is rendered
  // while this list is absent. Order sets the current-context.
  "kubectl": [],
  "auto_recover": {
    "max_attempts": 5
  },
  "guards": [
    {
      "regex": "rm -rf",
      "message": "rm -rf is blocked"
    },
    {
      "regex": "sudo .*",
      "message": "sudo is blocked"
    }
  ]
}
