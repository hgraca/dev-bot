{
  "project_name": "__PROJECT_NAME__",
  "harness": "opencode", // opencode | claudecode — the selected harness is the only one wired
  "devbot_dir": ".agents",
  // Workspace behaviour defaults live in .devbot.global.jsonc::workspace.
  // State a key here only when this project differs from those defaults:
  //   "workspace": { "type": "polyrepo", "commit_memory": true,
  //                  "workflow": "trunk" }
  // `type` is "repo" (the default) or "polyrepo" — a container project that
  // orchestrates the managed projects registered in the global `projects`
  // array, with memory scope resolved from the files the session touches.
  // Opt in BY NAME to datasources declared in .devbot.global.jsonc. Only these
  // are registered with this project's harness — the rest cost nothing, not
  // even context.
  "datasources": [],
  // Opt in BY NAME to clusters declared in .devbot.global.jsonc::kubectl.clusters.
  // The project gets its own ~/.kube/devbot/<project>.yaml; nothing is rendered
  // while this list is absent. Order sets the current-context.
  "kubectl": [],
  // AutoBot: scheduled agent work for this project. Everything is off by default.
  // Instead of the block below, you can name a profile declared in .devbot.global.jsonc:
  //   "autobot": "gete-jira"
  // poll_jira / poll_github enable the deterministic follow-up pollers; `prompts`
  // schedules agent prompts on a 5-field cron. An all-defaults block does nothing.
  "autobot": {
    "poll_jira": false,
    "poll_github": false,
    // The Jira connection is per project, and ${VAR} is resolved at tick time from the
    // environment the cron entry sources (~/.config/devbot/autobot.env).
    // "jira_base_url": "https://getinfo.atlassian.net",
    // "jira_email": "you@example.com",
    // this is needed in the cron job: set JIRA_API_TOKEN in ~/.config/devbot/autobot.env
    // (export JIRA_API_TOKEN=paste-the-token-here) or put the token directly here
    // "jira_api_token": "${JIRA_API_TOKEN}",
    // Required. Only pick up tickets assigned to these people; [] picks up nothing.
    "jira_assignees": [],
    "prompts": []
  },
  "auto_recover": {
    "max_attempts": 5
  },
  "guards": [
    {
      "regex": "rm -rf",
      "message": "rm -rf is blocked"
    },
    {
      "regex": "sudo .*",
      "message": "sudo is blocked"
    }
  ]
}
