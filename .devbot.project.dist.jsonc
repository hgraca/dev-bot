{
  "project_name": "__PROJECT_NAME__",
  "harness": "opencode",
  "devbot_dir": ".agents",
  "commit_memory": false,
  // Document collections searched by `search-memories`. `project` is reserved
  // for this project's own vault; custom keys add extra corpora. `semantic` is
  // reserved for qmd's model path and is inert today (BM25).
  "memory_collections": {
    "project": { "path": "{project}/{devbot_dir}/memory", "semantic": false }
  },
  "worktrees": true,
  // A supervisor project orchestrates work and memory across the managed
  // projects registered in .devbot.global.jsonc::projects. Memory scope is
  // resolved from the files the session touches. Default: a normal project.
  "supervisor": false,
  // Opt in BY NAME to datasources declared in .devbot.global.jsonc. Only these
  // are registered with this project's harness — the rest cost nothing, not
  // even context.
  "datasources": [],
  "auto_recover": {
    "max_attempts": 5
  },
  "guards": [
    {
      "regex": "rm -rf",
      "message": "rm -rf is blocked"
    },
    {
      "regex": "sudo .*",
      "message": "sudo is blocked"
    },
    {
      "regex": "git\\b(?:\\s+(?:-C|-c)\\s+(?:\"(?:[^\"\\\\]|\\\\.)*\"|'[^']*'|\\\\[^\\n]|[^\\s\"'\\\\])+|\\s+(?:--git-dir|--work-tree|--namespace|--exec-path|--super-prefix|--config-env)\\s+(?:\"(?:[^\"\\\\]|\\\\.)*\"|'[^']*'|\\\\[^\\n]|[^\\s\"'\\\\])+|\\s+(?!(?:-C|-c|(?:--git-dir|--work-tree|--namespace|--exec-path|--super-prefix|--config-env))(?:\\s|$))-(?:\"(?:[^\"\\\\]|\\\\.)*\"|'[^']*'|\\\\[^\\n]|[^\\s\"'\\\\])+)*\\s+(?:push\\b|\"push\"|'push')[^\\n]*(\\s-f\\b|\\s--force)",
      "message": "force push is prohibited"
    }
  ]
}
