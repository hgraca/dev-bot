{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "model": "opencode/nemotron-3.5-lightning-free",
  "small_model": "opencode/big-pickle",
  "instructions": ["AGENTS.md", ".agents/memory/active/**/*.md"],
  "plugin": ["opencode-codebase-index", ".opencode/plugins/on-hooks.ts"],
  "default_agent": "DevBot",
  "provider": {
    "cortecs": {
      "options": {
        "timeout": 300000,
        "headerTimeout": 60000,
        "chunkTimeout": 90000
      }
    }
  },
  "agent": {
    "plan": {
      "disable": true
    },
    "build": {
      "disable": true
    },
    "DevBot": {
      "model": "deepseek/deepseek-v4-flash",
      "variant": "high"
    },
    "Expert": {
      "model": "cortecs/kimi-k3",
      "variant": "high"
    },
    "Designer": {
      "model": "cortecs/kimi-k3",
      "variant": "high"
    },
    "TeamLead": {
      "model": "deepseek/deepseek-v4-flash",
      "variant": "high"
    },
    "Architect": {
      "model": "cortecs/kimi-k3",
      "variant": "high"
    },
    "PO": {
      "model": "deepseek/deepseek-v4-pro",
      "variant": "high"
    },
    "Critic": {
      "model": "deepseek/deepseek-v4-pro",
      "variant": "high"
    },
    "Developer": {
      "model": "deepseek/deepseek-v4-flash",
      "variant": "high"
    },
    "Tester": {
      "model": "deepseek/deepseek-v4-flash",
      "variant": "high"
    },
    "Reviewer": {
      "model": "deepseek/deepseek-v4-flash",
      "variant": "high"
    },
    "Security": {
      "model": "deepseek/deepseek-v4-pro",
      "variant": "high"
    },
    "Scout": {
      "model": "deepseek/deepseek-v4-flash",
      "variant": "high"
    }
  },
  "permission": {
    "external_directory": {
      "*": "deny",
      "/tmp/**": "allow"
    },
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "allow",
      "sudo *": "ask"
    },
    "task": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",
    "lsp": "allow",
    "doom_loop": "allow",
    "skill": "allow"
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "vendor/**",
      "dist/**",
      "build/**",
      ".git/**",
      ".cache/**",
      "*no-vcs*",
      "*no-vcs*/**",
      "storage/**",
      ".idea/**",
      ".vscode/**",
      ".env*"
    ]
  },
  "mcp": {
    "websearch": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa",
      "enabled": true,
      "oauth": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "oauth": false
    },
    "codebase-index": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "-p",
        "opencode-codebase-index",
        "-p",
        "@modelcontextprotocol/sdk",
        "opencode-codebase-index-mcp",
        "--project",
        "."
      ],
      "enabled": true
    },
    "qmd": {
      "type": "local",
      "command": ["qmd", "mcp"],
      "enabled": true,
      "environment": {
        "QMD_LLAMA_GPU": true
      }
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "bash",
        "-c",
        "mkdir -p .agents/logs && if [ \"$(uname -s)\" = \"Darwin\" ]; then CHROME_REAL=\"$(ls \"$HOME\"/.cache/ms-playwright/chromium-*/chrome-mac/Chromium.app/Contents/MacOS/Chromium 2>/dev/null | head -1)\"; else CHROME_REAL=\"$(ls \"$HOME\"/.cache/ms-playwright/chromium-*/chrome-linux*/chrome 2>/dev/null | head -1)\"; fi && if [ -n \"$CHROME_REAL\" ]; then WRAP=\"$HOME/.cache/ms-playwright/chrome-nosandbox\"; printf '#!/bin/bash\\nexec \"%s\" --no-sandbox \"$@\"\\n' \"$CHROME_REAL\" > \"$WRAP\"; chmod +x \"$WRAP\"; exec node .opencode/chrome-devtools-mcp-wrapper.js npx -y chrome-devtools-mcp@latest --headless --executablePath \"$WRAP\" 2>>.agents/logs/chrome-devtools-mcp.log; else exec node .opencode/chrome-devtools-mcp-wrapper.js npx -y chrome-devtools-mcp@latest --headless 2>>.agents/logs/chrome-devtools-mcp.log; fi"
      ]
    },
    "playwright": {
      "type": "local",
      "command": ["docker", "run", "--rm", "-i", "mcp/playwright"],
      "enabled": true
    },
    "next-devtools": {
      "type": "local",
      "command": ["npx", "-y", "next-devtools-mcp@latest"],
      "enabled": true
    },
    "devbot-tools": {
      "type": "local",
      "command": ["bash", ".opencode/tools-mcp-serve.sh"],
      "enabled": true
    }
  }
}
