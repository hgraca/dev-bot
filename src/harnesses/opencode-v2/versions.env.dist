# Pinned versions for the opencode-v2 harness — the shipped default. Nothing
# reads the live versions.env beside this file yet: the harness resolves its
# binary by probing, so this records the pin rather than enforcing it.
#
# The 2.x host installs beside v1 rather than replacing it: the binary lives in
# ~/.opencode/v2 and is shimmed as `opencode2` on PATH, so `opencode` keeps
# launching the 1.x line.
OPENCODE2_VERSION=2.3.0
