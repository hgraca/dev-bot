{
  // The plugins this build SHIPS, so an existing project's stale dev-bot plugin
  // packages can be retired. They are NOT config entries: every one lives under
  // .opencode/plugins/, which v2 auto-loads, and listing one there registers the
  // plugin twice — the host then fails the second copy ("Duplicate plugin ID").
  // _ensure_required_plugins skips this prefix for that reason.
  //
  // Scope is every plugin the dist ships — a project seeded earlier should
  // converge on it rather than keep a subset. Additions only: a removal cannot
  // propagate, because "remove anything the dist does not list" would delete
  // plugins a project added itself.
  //
  // No `tui` list: v2 TUI parts are exports of the plugin packages themselves,
  // not separately registered paths.
  "server": [
    ".opencode/plugins/on-hooks",
    ".opencode/plugins/mcp-sync",
    ".opencode/plugins/skill-name-resolver",
    // Carries a ./tui export: the pane-title TUI part rides on this package,
    // and _retire_stale_plugin_dirs deletes any package not declared here.
    ".opencode/plugins/herdr-pane-title"
  ]
}
