{
  // The plugins an existing project's config is reconciled up to, so a project
  // seeded before a plugin existed does not silently diverge from the dist.
  //
  // Scope is EVERY plugin the dists ship, deliberately: the dist's `plugin`
  // arrays are the source of truth for what the dev-bot harness runs with, and a
  // project that was seeded earlier should converge on them rather than keep a
  // subset. Additions only — a removal from a dist cannot propagate, because
  // "remove anything the dist does not list" would delete plugins a project
  // added itself. Removing something already seeded is a deliberate hand edit.
  //
  // Keep this in step with the dists: the test suite asserts each dist plugin
  // appears here, so a new dist entry cannot be forgotten.
  "server": [".opencode/plugins/on-hooks.ts", "opencode-pty@0.3.6"],
  "tui": ["opencode-tabs@0.3.0", "./tui-plugins/pty-monitor/index.ts"]
}
