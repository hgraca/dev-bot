{
  // Plugins dev-bot's OWN features depend on — not ergonomics. init.sh reconciles
  // exactly this list into an already-seeded project config, because the dist is
  // applied only at first seed: an entry added to a dist afterwards never reaches
  // a project that already has the file.
  //
  // Membership test: if dev-bot's own code breaks without it, it belongs here.
  //   opencode-pty  the PTY monitor TUI plugin calls its `pty-show-server-url`
  //                 command; without it the panel shows "server unavailable"
  //                 and the cause is invisible.
  // Deliberately NOT here: opencode-tabs and any other convenience plugin. Those
  // ship in the dist for NEW projects, but an existing project's plugin choices
  // are the user's, so they are left exactly as set.
  "server": ["opencode-pty@0.3.6"],
  "tui": ["./tui-plugins/pty-monitor/index.ts"]
}
