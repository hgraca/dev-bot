{
  "$schema": "https://opencode.ai/config.json",
  // LSP: all built-ins are enabled; the object form overrides named servers only.
  // The PHP override trims what Intelephense indexes. Intelephense reads these
  // settings only via LSP workspace/configuration (opencode answers it from
  // server.initialization); a project-root intelephense.config.json is NOT read.
  // vendor/ itself stays indexed so library symbols resolve — only vendor
  // test/doc subtrees are skipped. The exclude list applies at the workspace
  // root, so every vendor pattern carries a `vendor/` segment and cannot touch
  // the project's own tests/ or docs/.
  "lsp": {
    "php intelephense": {
      "command": [
        "bash",
        "__DEV_BOT_ROOT__/src/harnesses/opencode/lsp/intelephense.sh",
        "--stdio"
      ],
      "initialization": {
        // telemetry must sit inside the `intelephense` section: opencode answers
        // workspace/configuration with initialization["intelephense"] only.
        "intelephense": {
          "telemetry": { "enabled": false },
          "files": {
            "exclude": [
              "**/.git/**",
              "**/.svn/**",
              "**/.hg/**",
              "**/CVS/**",
              "**/.DS_Store/**",
              "**/.agents/worktrees/**",
              "**/node_modules/**",
              "**/bower_components/**",
              "**/.history/**",
              "**/vendor/**/tests/**",
              "**/vendor/**/Tests/**",
              "**/vendor/**/docs/**",
              "**/vendor/**/vendor/**"
            ]
          }
        }
      }
    }
  },
  "model": "opencode/nemotron-3.5-lightning-free", // or "litellm/default"
  "small_model": "opencode/big-pickle", // or "litellm/low"
  // Snapshot tracking diffs the whole workspace on every step; disabled
  // because undo/revert is not used in this workspace.
  "snapshots": false,
  //  "provider": {
  //    "litellm": {
  //      "npm": "@ai-sdk/openai-compatible",
  //      "name": "LiteLLM",
  //      "options": {
  //        "baseURL": "http://localhost:18000/v1"
  //      },
  //      "models": {
  //        "orchestrator": { "name": "Orchestrator" },
  //        "architect": { "name": "Architect" },
  //        "po": { "name": "Po" },
  //        "critic": { "name": "Critic" },
  //        "developer": { "name": "Developer" },
  //        "tester": { "name": "Tester" },
  //        "reviewer": { "name": "Reviewer" },
  //        "security": { "name": "Security" },
  //        "scout": { "name": "Scout" },
  //        "highest": { "name": "highest" },
  //        "high": { "name": "high" },
  //        "default": { "name": "default" },
  //        "low": { "name": "low" },
  //        "lowest": { "name": "lowest" }
  //      }
  //    }
  //  },
  "instructions": ["AGENTS.md", ".agents/memory/active/**/*.md"],
  // opencode-pty is PINNED deliberately: it supplies agent capability
  // (non-blocking, interactive PTY sessions), not cosmetics, so silently
  // following upstream `latest` is a worse risk than a manual bump. Verify it
  // against the harness before raising the version. TUI plugins live in
  // tui.dist.jsonc — never here (see that file for why).
  "plugin": [
    ".opencode/plugins/on-hooks.ts",
    ".opencode/plugins/mcp-sync.ts",
    "opencode-pty@0.3.6"
  ],
  "default_agent": "devbot",
  // Provider-level timeouts: aborts requests that hang without emitting
  // (cortecs/kimi-k3 was observed to stall silently for minutes — see
  // src/harnesses/opencode/hooks/on-watchdog-silent-stall.ts). chunkTimeout
  // aborts a stream with no SSE chunk for 90s, surfacing the failure to
  // auto-recover instead of hanging forever.
  "provider": {
    "cortecs": {
      "options": {
        "timeout": 300000,
        "headerTimeout": 60000,
        "chunkTimeout": 90000
      }
    }
  },
  "agent": {
    "plan": { "disable": true },
    "build": { "disable": true },
    // opencode free
    //    "devbot": { "model": "opencode/mimo-v2.5-free", "variant": "high" },
    //    "expert": { "model": "opencode/kimi-k3", "variant": "high" },
