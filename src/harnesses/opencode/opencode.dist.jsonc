    //    "scout": { "model": "cortecs/deepseek-v4-flash", "variant": "high" }
    // deepseek
    "devbot": { "model": "deepseek/deepseek-flash", "variant": "high" },
    "expert": { "model": "cortecs/kimi-k3", "variant": "high" },
    "designer": { "model": "cortecs/kimi-k3", "variant": "high" },
    "teamlead": { "model": "deepseek/deepseek-flash", "variant": "high" },
    "architect": { "model": "cortecs/kimi-k3", "variant": "high" },
    "po": { "model": "deepseek/deepseek-flash", "variant": "high" },
