    //    "architect": { "model": "opencode/kimi-k3", "variant": "high" },
    //    "po": { "model": "opencode/deepseek-v4-flash", "variant": "high" },
    //    "critic": { "model": "opencode/deepseek-v4-pro", "variant": "high" },
    //    "developer": { "model": "opencode/deepseek-v4-flash", "variant": "high" },
    //    "tester": { "model": "opencode/deepseek-v4-flash", "variant": "high" },
    //    "reviewer": { "model": "opencode/deepseek-v4-pro", "variant": "high" },
    //    "security": { "model": "opencode/deepseek-v4-pro", "variant": "high" },
    //    "scout": { "model": "opencode/deepseek-v4-flash", "variant": "high" },
    // cortecs
    //    "devbot": { "model": "cortecs/deepseek-v4-flash", "variant": "high" },
    //    "expert": { "model": "cortecs/kimi-k3", "variant": "high" },
    //    "designer": { "model": "cortecs/kimi-k3", "variant": "high" },
    //    "teamlead": { "model": "cortecs/deepseek-v4-pro", "variant": "high" },
    //    "architect": { "model": "cortecs/kimi-k3", "variant": "high" },
    //    "po": { "model": "cortecs/deepseek-v4-pro", "variant": "high" },
    //    "critic": { "model": "cortecs/deepseek-v4-pro", "variant": "high" },
    //    "developer": { "model": "cortecs/deepseek-v4-flash", "variant": "high" },
