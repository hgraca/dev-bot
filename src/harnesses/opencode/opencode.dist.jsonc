{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "model": "opencode/nemotron-3.5-lightning-free", // or "litellm/default"
  "small_model": "opencode/big-pickle", // or "litellm/low"
  //  "provider": {
  //    "litellm": {
  //      "npm": "@ai-sdk/openai-compatible",
  //      "name": "LiteLLM",
  //      "options": {
  //        "baseURL": "http://localhost:18000/v1"
  //      },
  //      "models": {
  //        "orchestrator": { "name": "Orchestrator" },
  //        "architect": { "name": "Architect" },
  //        "po": { "name": "Po" },
  //        "critic": { "name": "Critic" },
  //        "developer": { "name": "Developer" },
  //        "tester": { "name": "Tester" },
  //        "reviewer": { "name": "Reviewer" },
  //        "security": { "name": "Security" },
  //        "scout": { "name": "Scout" },
  //        "highest": { "name": "highest" },
  //        "high": { "name": "high" },
  //        "default": { "name": "default" },
  //        "low": { "name": "low" },
  //        "lowest": { "name": "lowest" }
  //      }
  //    }
  //  },
  "instructions": ["AGENTS.md", ".agents/memory/active/**/*.md"],
  "plugin": [".opencode/plugins/on-hooks.ts"],
  "default_agent": "DevBot",
  // Provider-level timeouts: aborts requests that hang without emitting
  // (cortecs/kimi-k3 was observed to stall silently for minutes — see
  // src/harnesses/opencode/hooks/on-watchdog-silent-stall.ts). chunkTimeout
  // aborts a stream with no SSE chunk for 90s, surfacing the failure to
  // auto-recover instead of hanging forever.
  "provider": {
    "cortecs": {
      "options": {
        "timeout": 300000,
        "headerTimeout": 60000,
        "chunkTimeout": 90000
      }
    }
  },
  "agent": {
    "plan": { "disable": true },
    "build": { "disable": true },
    // opencode free
    //    "DevBot": { "model": "opencode/mimo-v2.5-free", "variant": "high" },
    //    "Expert": { "model": "opencode/kimi-k3", "variant": "high" },
