    //    "teamlead": { "model": "litellm/orchestrator", "variant": "high" },
    //    "architect": { "model": "litellm/architect", "variant": "high" },
    //    "po": { "model": "litellm/po", "variant": "high" },
    //    "critic": { "model": "litellm/critic", "variant": "high" },
    //    "developer": { "model": "litellm/developer", "variant": "high" },
    //    "tester": { "model": "litellm/tester", "variant": "high" },
    //    "reviewer": { "model": "litellm/reviewer", "variant": "high" },
    //    "security": { "model": "litellm/security", "variant": "high" },
    //    "scout": { "model": "litellm/scout", "variant": "high" }
  },
  "permission": {
    "external_directory": {
      "*": "deny",
      "/tmp/**": "allow"
    },
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "allow",
      "sudo *": "ask"
    },
    "task": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",
    "lsp": "allow",
    "doom_loop": "allow",
    "skill": "allow"
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "vendor/**",
      "dist/**",
      "build/**",
      ".git/**",
      ".cache/**",
      "*no-vcs*",
      "*no-vcs*/**",
      "storage/**",
      ".idea/**",
      ".vscode/**",
      ".env*"
    ]
  }
}
