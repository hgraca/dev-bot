{
  "PreToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "python3 .claude/plugins/on-hooks.py pre-tool"
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Edit|Write",
      "hooks": [
        {
          "type": "command",
          "command": "python3 .claude/plugins/on-hooks.py post-file"
        }
      ]
    },
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "python3 .claude/plugins/on-hooks.py post-bash"
        }
      ]
    },
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "bash .claude/plugins/on-posttooluse-auto-recover.sh"
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "python3 .claude/plugins/on-hooks.py stop"
        }
      ]
    },
    {
      "hooks": [
        {
          "type": "command",
          "command": "bash .claude/plugins/on-stop-auto-recover.sh"
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "python3 .claude/plugins/on-hooks.py startup"
        }
      ]
    }
  ]
}
