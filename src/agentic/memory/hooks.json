{
  "hooks": [
    {
      "id": "reindex-memories",
      "event": "file.edited",
      "match": {
        "file": "/memory/latent/.*\\.md$"
      },
      "run": [
        "bash",
        "{module}/tools/reindex-passive-memories.sh",
        "--file",
        "{file}",
        "--worktree",
        "{worktree}"
      ],
      "log": ".agents/logs/memory-index.log"
    }
  ]
}
