#!/usr/bin/env bash
# =============================================================================
# fake-mcp — stubs the opencode-codebase-index-mcp server for testing.
# Reads JSON-RPC from stdin line by line and responds with canned data.
#
# Handles:
#   - initialize (id: 0) → result with protocol version
#   - notifications/initialized → no response
#   - tools/call (index_status, index_codebase, codebase_search, codebase_peek)
#     → appropriate canned response
#   - tools/call (unknown) → error response
# =============================================================================

set -euo pipefail

while IFS= read -r line; do
    if [[ -z "$line" ]]; then
        continue
    fi

    # Parse method and id from JSON
    method=$(echo "$line" | python3 -c "import sys,json; print(json.load(sys.stdin).get('method',''))" 2>/dev/null || echo "")
    msg_id=$(echo "$line" | python3 -c "import sys,json; print(json.load(sys.stdin).get('id',''))" 2>/dev/null || echo "")
    tool_name=$(echo "$line" | python3 -c "
import sys,json
p = json.load(sys.stdin).get('params',{})
print(p.get('name','') if isinstance(p,dict) else '')" 2>/dev/null || echo "")

    if [[ "$method" == "initialize" ]]; then
        echo '{"jsonrpc":"2.0","id":'"$msg_id"',"result":{"protocolVersion":"2024-11-05","capabilities":{"tools":{}},"serverInfo":{"name":"opencode-codebase-index-mcp","version":"1.0.0"}}}'
    elif [[ "$method" == "notifications/initialized" ]]; then
        # No response for notifications
        :
    elif [[ "$method" == "tools/call" ]]; then
        local ollama_api="${OLLAMA_LOCAL_API:-http://localhost:18434}"
    case "$tool_name" in
            index_status)
                echo '{"jsonrpc":"2.0","id":'"$msg_id"',"result":{"status":"ok","chunkCount":42,"model":"nomic-embed-text","baseUrl":"'"${ollama_api}"'/v1","embeddingDimension":768}}'
                ;;
            index_codebase)
                echo '{"jsonrpc":"2.0","id":'"$msg_id"',"result":{"status":"ok","chunkCount":42}}'
                ;;
            codebase_search)
                echo '{"jsonrpc":"2.0","id":'"$msg_id"',"result":{"results":[{"filePath":"src/main.py","line":1,"content":"def fibonacci(n):\\n    return n if n < 2 else fibonacci(n-1) + fibonacci(n-2)","kind":"function","name":"fibonacci"},{"filePath":"src/utils/helper.ts","line":1,"content":"export function greet(name: string): string {\\n    return \\\"Hello, \\\" + name;\\n}","kind":"function","name":"greet"}]}}'
                ;;
            codebase_peek)
                echo '{"jsonrpc":"2.0","id":'"$msg_id"',"result":{"results":[{"filePath":"src/main.py","line":1,"name":"fibonacci","kind":"function"},{"filePath":"src/utils/helper.ts","line":1,"name":"greet","kind":"function"}]}}'
                ;;
            *)
                echo '{"jsonrpc":"2.0","id":'"$msg_id"',"error":{"code":-32601,"message":"Method not found: '"$tool_name"'"}}'
                ;;
        esac
    else
        # Unknown method — error
        echo '{"jsonrpc":"2.0","id":'"$msg_id"',"error":{"code":-32601,"message":"Method not found: '"$method"'"}}'
    fi
done

exit 0
