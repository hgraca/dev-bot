# SonarQube MCP server image pin.
#
# install.sh pulls exactly this tag; update.sh bumps it to the newest release on
# the generic 1.x line. Override per machine with SONARQUBE_MCP_IMAGE (a full
# image reference) if you need a Server-aligned tag such as 2026.5.1.
SONARQUBE_MCP_IMAGE_TAG=1.30.0.4763
