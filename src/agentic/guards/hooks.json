{
  "hooks": [
    {
      "id": "guards",
      "event": "command.before",
      "match": { "tool": ["bash", "shell", "pty_spawn", "pty_write"] },
      "run": [
        "bun",
        "{module}/tools/guards.ts",
        "--command",
        "{command}",
        "--global-config",
        "{global-config}",
        "--project-config",
        "{project-config}"
      ],
      "blocking": true
    }
  ]
}
