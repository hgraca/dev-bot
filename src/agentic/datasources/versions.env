# datasources dependency pin.
#
# The mcp-toolbox image the shared gateway runs. Pinned deliberately: the
# generated tools.yaml is read by exactly this version, and toolbox's
# source/tool schema is versioned with the binary.
TOOLBOX_VERSION=1.11.0
TOOLBOX_IMAGE=us-central1-docker.pkg.dev/database-toolbox/toolbox/toolbox
