# datasources dependency pin.
#
# The mcp-toolbox image the shared gateway runs. Pinned deliberately: the
# generated tools.yaml is read by exactly this version, and toolbox's
# source/tool schema is versioned with the binary.
TOOLBOX_VERSION=1.11.0
TOOLBOX_IMAGE=us-central1-docker.pkg.dev/database-toolbox/toolbox/toolbox

# Sidecar (non-toolbox) datasources run `uvx` inside the official uv image. The
# runner image floats on its python tag; the TOOL SURFACE is the package, and
# that is pinned per type below, so a reinit is reproducible.
SIDECAR_UV_IMAGE=ghcr.io/astral-sh/uv:python3.12-trixie-slim
OPENSEARCH_MCP_VERSION=0.12.0

# dev-bot's own read-only S3 server: an image built from
# src/agentic/datasources/s3-mcp, tagged with this name.
S3_MCP_IMAGE=devbot-datasources-s3-mcp:local
