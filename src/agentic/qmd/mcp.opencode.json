{
  "qmd": {
    "type": "local",
    "command": [
      "bash",
      "-c",
      "mkdir -p .agents/logs && exec qmd mcp 2>>.agents/logs/qmd-mcp.log"
    ],
    "enabled": true,
    "environment": {
      "QMD_LLAMA_GPU": "__GPU_ENABLED__",
      "QMD_EXPAND_CONTEXT_SIZE": "512",
      "QMD_RERANK_CONTEXT_SIZE": "1024"
    }
  }
}
