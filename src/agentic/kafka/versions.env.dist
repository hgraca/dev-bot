# mcp-confluent pin — the shipped default. `devbot update` bumps the machine's
# gitignored versions.env; edit this to move what new machines get.
#
# The launcher execs whatever npm installed, so the pin is a decision for
# install/update time — never a version resolved at launch, where a stalled npm
# fetch would outrun the MCP client's init budget.
MCP_CONFLUENT_VERSION=1.6.1
