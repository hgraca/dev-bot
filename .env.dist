# DevBot environment template — copy to .env (gitignored) and fill in what you use.
#
# Secrets stay out of every tracked file: reference a variable from
# .devbot.global.jsonc as ${VAR} (datasources, aws_connections) or from a
# module's mcp.json as {env:VAR} (MCP authentication). `devbot up` loads this
# file with `set -a`, so ${VAR} references expand at load time.

# ── Model providers (for LiteLLM) ───────────────────────────────

# You only need to set these if you use LiteLLM as the provider.

CORTECS_API_KEY=
GITHUB_COPILOT_KEY=
DEEPSEEK_API_KEY=
# Gemini: https://aistudio.google.com/apikey (free tier, no credit card)
GEMINI_API_KEY=
# Groq: https://console.groq.com/keys (free tier, no credit card)
GROQ_API_KEY=
# OpenRouter: https://openrouter.ai/keys (free tier, no credit card)
OPENROUTER_API_KEY=
# OpenCode Zen: https://opencode.ai/zen (free models available)
ZEN_API_KEY=
# Puter: https://puter.com/dashboard#account (free models available)
PUTER_API_KEY=

# ── MCP authentication ──────────────────────────────────────────

# SigNoz gateway: service-account API key, sent as the SIGNOZ-API-KEY header.
SIGNOZ_AUTH_TOKEN=
# SigNoz instance the gateway talks to (defaults to https://signoz.get-e.com).
# SIGNOZ_URL=https://signoz.get-e.com

# Sentry MCP: user auth token, sent as `Authorization: Sentry-Bearer`.
SENTRY_ACCESS_TOKEN=

# Atlassian Rovo MCP: optional API token for non-interactive use. Interactive
# sessions use OAuth (`opencode mcp auth atlassian`) and need nothing here.
# ATLASSIAN_API_KEY=

# Notion MCP: optional MCP token for non-interactive use (Business/Enterprise).
# Interactive sessions use OAuth (`opencode mcp auth notion`).
# NOTION_MCP_TOKEN=

# JetBrains MCP: project path override (defaults to the current directory).
# JETBRAINS_PROJECT_PATH=

# ── AWS ─────────────────────────────────────────────────────────

# Base key pair referenced by the connections and datasources below.
# Use a read-only identity: one IAM user, least privilege, no console access.
AWS_KEY=
AWS_SECRET=

# Read-only production connection (`aws_connections: aws-prod-ro`).
AWS_PROD_RO_ACCESS_KEY_ID=${AWS_KEY}
AWS_PROD_RO_SECRET_ACCESS_KEY=${AWS_SECRET}

# Temporary credentials additionally need the session token.
# AWS_SESSION_TOKEN=

# ── Datasources: MariaDB ────────────────────────────────────────

MARIADB_DEV_HOST=
MARIADB_DEV_USER=
MARIADB_DEV_PASSWORD=

MARIADB_STG_HOST=
MARIADB_STG_USER=
MARIADB_STG_PASSWORD=
# Optional write-enabled staging pair, for a source that declares it.
MARIADB_STG_WRITE_USER=
MARIADB_STG_WRITE_PASSWORD=

MARIADB_PROD_HOST=
MARIADB_PROD_USER=
MARIADB_PROD_PASSWORD=

# ── Datasources: MongoDB ────────────────────────────────────────

MONGO_DEV_DSN=
MONGODB_PROD_DSN=

# ── Datasources: OpenSearch ─────────────────────────────────────

OPENSEARCH_STG_URL=
OPENSEARCH_PROD_URL=
OPENSEARCH_PROD_ACCESS_KEY_ID=${AWS_KEY}
OPENSEARCH_PROD_SECRET_ACCESS_KEY=${AWS_SECRET}

# ── Datasources: S3 ─────────────────────────────────────────────

S3_PROD_ACCESS_KEY_ID=${AWS_KEY}
S3_PROD_SECRET_ACCESS_KEY=${AWS_SECRET}

# ── Optional service endpoints ──────────────────────────────────

# Overrides for the shared MCP gateways (defaults shown).
# SIGNOZ_MCP_URL=http://127.0.0.1:18502/mcp
# CODEBASE_MEMORY_MCP_URL=http://127.0.0.1:18504/mcp
# OLLAMA_API_URL=http://localhost:18434
