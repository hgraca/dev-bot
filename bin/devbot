#!/usr/bin/env bash
# =============================================================================
# bin/devbot — CLI entry point for the dev-bot agent kit.
#
# Usage:
#   devbot help       Show available commands
#   devbot install    Install tools (bin/install.sh)
#   devbot update [tag]  Update dev-bot: newest release tag, or <tag> if given
# =============================================================================

set -euo pipefail

# Resolve the project root (this script lives at bin/devbot, so .. is root).
# `readlink -f` is not portable (unavailable on macOS/BSD), so resolve any
# symlink chain manually before computing the parent directory.
_devbot_resolve_symlink() {
  local target="$1"
  while [[ -L "${target}" ]]; do
    local dir link
    dir="$(cd "$(dirname "${target}")" && pwd)"
    link="$(readlink "${target}")"
    [[ "${link}" != /* ]] && link="${dir}/${link}"
    target="${link}"
  done
  printf '%s' "${target}"
}
DEV_BOT_ROOT="$(cd "$(dirname "$(_devbot_resolve_symlink "${BASH_SOURCE[0]}")")/.." && pwd)"
export DEV_BOT_ROOT

# ── Source shared library ──────────────────────────────────────────────────────
# shellcheck source=../src/_shared/functions.sh
source "${DEV_BOT_ROOT}/src/_shared/functions.sh"

# ── Commands ──────────────────────────────────────────────────────────────────

cmd_help() {
  echo -e "${TEXT_BOLD}dev-bot — Agent kit for the GET-E engineering team${TEXT_CLEAR}"
  echo
  echo -e "${TEXT_BOLD}Usage:${TEXT_CLEAR}"
  echo "  devbot <command>"
  echo
  echo -e "${TEXT_BOLD}Commands:${TEXT_CLEAR}"
  echo "  help       Show this help"
  echo "  install    Install all tools (bin/install.sh)"
  echo "  update [tag] [--auto]  Update dev-bot: newest release tag, or <tag> if given (bin/update.sh)"
  echo "  tool <name>  Run a dev-bot tool by name (e.g. tree, git-report)"
  echo "  list <type>  List agentic artifacts (commands, agents, skills, hooks, mcps, tools)"
  echo "             [-a|--all]  Include artifacts from disabled modules"
  echo "  init [path]  Initialize dev-bot in a project directory (default: .)"
  echo "  reinit [--all|-a]  Re-initialize dev-bot (current project, or all with --all)"
  echo "  up           Start docker services (docker compose up)"
  echo "  down         Stop docker services (docker compose down)"
  echo "  prune [days] [--all|-a]  Prune old opencode sessions (default: 30 days)"
  echo "  stats [--days=N] [--all|-a] [--harness=H]  Tool + MCP usage report (default: 30 days)"
  echo "  models     Manage LLM models via Ollama"
  echo "             pull <model>     Pull a model from registry"
  echo "             list-local        List locally available models"
  echo "             list-remote       Show remote model browsing info"
  echo "             remove <model>    Remove a locally cached model"
  echo "  module     Manage external modules"
  echo "             install    Clone/pull configured external modules"
  echo "             init [path] Wire modules into .opencode/ directories"
  echo "             add <url|path>   Register a module (git URL or local path)"
  echo "             remove <name>    Unregister a module"
  echo "             list              List registered modules"
  echo "             sync              Re-wire all modules (alias for init)"
  echo
  echo -e "${TEXT_BOLD}Running without a known subcommand:${TEXT_CLEAR}"
  echo "  Starts the configured harness (opencode or claudecode) after running devbot up."
  echo
  # The CLI is global, but a user invoking it inside a project reads "Project
  # root" as scoping to the install. Distinguish the two: print the current
  # project (cwd walk-up for .devbot.project.jsonc) when inside one, and label
  # the install location clearly (audit-51 §6 NOTE).
  local proj_dir="${PWD}"
  while [[ -n "${proj_dir}" && "${proj_dir}" != "/" ]]; do
    if [[ -f "${proj_dir}/.devbot.project.jsonc" ]]; then
      echo -e "${TEXT_BOLD}Project:${TEXT_CLEAR} ${proj_dir}"
      break
    fi
    proj_dir="$(dirname "${proj_dir}")"
  done
  echo -e "${TEXT_BOLD}Install root:${TEXT_CLEAR} ${DEV_BOT_ROOT}"
}

cmd_install() {
  bash "${DEV_BOT_ROOT}/bin/install.sh"
}

cmd_update() {
  bash "${DEV_BOT_ROOT}/bin/update.sh" "$@"
}

cmd_models() {
  local action="${1:-help}"

  case "${action}" in
    pull)
      if [[ -z "${2:-}" ]]; then
        echo "Usage: devbot models pull <model>"
        echo "Example: devbot models pull llama3.2:3b"
        exit 1
      fi
      # Boot the ollama container if it isn't running, pull, and down it
      # again when this command started it (ollama is off by default — it
      # only runs when an enabled consumer needs it).
      _devbot_ollama_exec pull "$2"
      ;;
    list-local)
      _devbot_ollama_exec list
      ;;
    list-remote)
      # For list-remote, just show usage pointing to ollama.com/library
      echo "Browse available models at: https://ollama.com/library"
      echo ""
      echo "To list remote tags for a model, use:"
      echo "  curl -s https://registry.ollama.ai/v2/library/<model>/tags/list"
      echo ""
      # Also try to show what's available locally as a reference
      echo "Locally cached models:"
      docker exec dev-bot-ollama ollama list 2>/dev/null || echo "  (none)"
      ;;
    remove)
      if [[ -z "${2:-}" ]]; then
        echo "Usage: devbot models remove <model>"
        echo "Example: devbot models remove llama3.2:3b"
        docker exec dev-bot-ollama ollama list 2>/dev/null || true
        exit 1
      fi
      _devbot_ollama_exec rm "$2"
      ;;
    help|--help|-h)
      echo "Usage: devbot models <subcommand>"
      echo ""
      echo "Subcommands:"
      echo "  pull <model>       Pull a model from the Ollama registry"
      echo "  list-local         List locally cached models"
      echo "  list-remote        Show remote model browsing info"
      echo "  remove <model>     Remove a locally cached model"
      ;;
    *)
      echo "Unknown models subcommand: ${action}"
      echo "Run 'devbot models help' for available subcommands."
      exit 1
      ;;
  esac
}

# List available tool names from both agentic and tools modules.
_list_tool_names() {
  local -a tool_dirs=("${DEV_BOT_ROOT}/src/agentic/"*/)
  tool_dirs+=("${DEV_BOT_ROOT}/src/tools/"*/)
  for tool_dir in "${tool_dirs[@]}"; do
    while IFS= read -r -d '' sh; do
      echo "  $(basename "${sh}" .sh)"
    done < <(find "${tool_dir}tools" -name '*.sh' -type f -print0 2>/dev/null)
  done
}

cmd_tool() {
  local tool_name="${1:-}"

  if [[ -z "${tool_name}" ]]; then
    echo "Usage: devbot tool <name> [args...]"
    echo ""
    echo "Available tools:"
    _list_tool_names
    exit 1
  fi

  # Find the tool script by searching all modules
  local tool_script=""
  while IFS= read -r -d '' sh; do
    local base
    base="$(basename "${sh}" .sh)"
    # Accept both "qmd.mcp" and bare "qmd" (the scripts are <name>.mcp.sh)
    if [[ "${base}" == "${tool_name}" || "${base%.mcp}" == "${tool_name}" ]]; then
      tool_script="${sh}"
      break
    fi
  done < <(find "${DEV_BOT_ROOT}/src/agentic" "${DEV_BOT_ROOT}/src/tools" -path '*/tools/*' -name '*.sh' -type f -print0 2>/dev/null)

  if [[ -z "${tool_script}" ]]; then
    echo "Error: unknown tool '${tool_name}'" >&2
    echo "Available tools:" >&2
    _list_tool_names >&2
    exit 1
  fi

  shift
  exec "${tool_script}" "$@"
}

_list_usage() {
  echo "Usage: devbot list <type> [-a|--all]"
  echo
  echo "List artifacts defined across agentic modules as a markdown table."
  echo
  echo "Types:"
  echo "  commands   Slash commands"
  echo "  agents     Agent definitions"
  echo "  skills     Skills"
  echo "  hooks      OpenCode plugin hooks"
  echo "  mcps       MCP servers"
  echo "  tools      Tools"
  echo
  echo "Options:"
  echo "  -a, --all   Include artifacts from disabled modules"
}

cmd_list() {
  local type="" all=false arg
  for arg in "$@"; do
    case "${arg}" in
      -a|--all) all=true ;;
      -h|--help)
        _list_usage
        return 0
        ;;
      -*)
        echo "Unknown argument: ${arg}" >&2
        _list_usage >&2
        return 1
        ;;
      *)
        if [[ -z "${type}" ]]; then
          type="${arg}"
        else
          echo "Unknown argument: ${arg}" >&2
          _list_usage >&2
          return 1
        fi
        ;;
    esac
  done

  if [[ -z "${type}" ]]; then
    _list_usage
    return 1
  fi

  case "${type}" in
    commands|agents|skills|hooks|mcps|tools) ;;
    *)
      echo "Unknown type: ${type}" >&2
      _list_usage >&2
      return 1
      ;;
  esac

  local disabled_json="[]"
  if [[ "${all}" == "false" ]]; then
    disabled_json="$(_devbot_get_disabled_modules)"
  fi

  python3 - "${DEV_BOT_ROOT}" "${type}" "${disabled_json}" "$(pwd)/$(_devbot_get_project_dir)/tools" "$(pwd)" <<'PY'
import glob
import json
import os
import sys
import unicodedata

root = sys.argv[1]
kind = sys.argv[2]
disabled = set(json.loads(sys.argv[3]) if len(sys.argv) > 3 else [])

AGENTIC = os.path.join(root, "src", "agentic")

def module_of(path):
    # Prefer the module subdir under src/agentic (e.g. src/agentic/git/tools/... → "git").
    rel = os.path.relpath(path, AGENTIC)
    parts = rel.split(os.sep)
    if parts and parts[0] not in ("..", "."):
        return parts[0]
    # Non-agentic path (e.g. src/tools/devbot-cli/tools/...): fall back to the
    # module dir name so the listing never shows a raw relpath escape ("..").
    # Audit-24 NOTE-7: list-projects lives in src/tools/devbot-cli/tools/.
    for marker in (os.sep + "src" + os.sep + "tools" + os.sep, os.sep + "src" + os.sep + "agentic" + os.sep):
        idx = path.find(marker)
        if idx != -1:
            rest = path[idx + len(marker):]
            mod = rest.split(os.sep)[0]
            if mod and mod not in ("..", "."):
                return mod
    # Last resort: the parent dir name of the file.
    return os.path.basename(os.path.dirname(path))

def read(path):
    with open(path, encoding="utf-8") as f:
        return f.read()

def parse_frontmatter(text):
    meta = {}
    if text.startswith("---"):
        parts = text.split("---", 2)
        if len(parts) >= 3:
            for line in parts[1].splitlines():
                line = line.strip()
                if line.startswith("name:"):
                    meta["name"] = line[len("name:"):].strip().strip('"')
                elif line.startswith("description:"):
                    meta["description"] = line[len("description:"):].strip().strip('"')
                elif line.startswith("mode:"):
                    meta["mode"] = line[len("mode:"):].strip().strip('"')
    return meta

def parse_tool_description(text):
    for line in text.splitlines()[:20]:
        line = line.strip()
        if line.startswith("# description:"):
            return line[len("# description:"):].strip()
    return ""

def display_width(s):
    return sum(2 if unicodedata.east_asian_width(c) in ("W", "F") else 1 for c in s)

def pad(s, w):
    return s + " " * max(0, w - display_width(s))

def collect(kind):
    if kind == "commands":
        headers = ["Module", "Command", "Description"]
        rows = []
        # audit-53 FAIL-2: audit.md/audit-fix.md live in src/tools/devbot-cli/
        # commands — the agentic-only glob silently omitted them (mirrors the
        # audit-24 NOTE-7 fix for the tools kind).
        files = sorted(
            set(glob.glob(os.path.join(AGENTIC, "*", "commands", "*.md")))
            | set(glob.glob(os.path.join(root, "src", "tools", "*", "commands", "*.md")))
        )
        for f in files:
            m = parse_frontmatter(read(f))
            if m.get("name"):
                rows.append([module_of(f), m["name"], m.get("description", "")])
        return headers, rows

    if kind == "agents":
        headers = ["Module", "Agent", "Type", "Description"]
        rows = []
        for f in sorted(glob.glob(os.path.join(AGENTIC, "*", "agents", "*.md"))):
            m = parse_frontmatter(read(f))
            if m.get("name"):
                rows.append([module_of(f), m["name"], m.get("mode", ""), m.get("description", "")])
        return headers, rows

    if kind == "skills":
        headers = ["Module", "Skill", "Description"]
        rows = []
        for f in sorted(glob.glob(os.path.join(AGENTIC, "*", "skills", "**", "SKILL.md"), recursive=True)):
            m = parse_frontmatter(read(f))
            if m.get("name"):
                rows.append([module_of(f), m["name"], m.get("description", "")])
        return headers, rows

    if kind == "hooks":
        headers = ["Module", "Hook"]
        rows = []
        for f in sorted(glob.glob(os.path.join(AGENTIC, "*", "hooks.json"))):
            try:
                data = json.loads(read(f))
            except Exception:
                continue
            for hook in data.get("hooks", []):
                hid = hook.get("id")
                if hid:
                    rows.append([module_of(f), hid])
        return headers, rows

    if kind == "mcps":
        headers = ["Module", "MCP"]
        rows = []
        # Module definitions live in the single canonical manifest mcp.json
        # ({ "mcp": { "<server>": ... } }) — see docs/mcp-config.md.
        for f in sorted(glob.glob(os.path.join(AGENTIC, "*", "mcp.json"))):
            try:
                data = json.loads(read(f))
            except Exception:
                continue
            for server in sorted(data.get("mcp", {})):
                rows.append([module_of(f), server])
        # Harness-level servers are not module definitions — they are written
        # as dynamic manifests in the project's .opencode/ (e.g. jetbrains by
        # src/agentic/jetbrains/init.sh). List them tagged (harness) so the
        # palette matches what opencode.jsonc actually registers (audit-24
        # NOTE-3: listing showed 7 while the config registers 8).
        project_dir = sys.argv[5] if len(sys.argv) > 5 else ""
        for f in sorted(glob.glob(os.path.join(project_dir, ".opencode", "*.mcp.json"))):
            try:
                data = json.loads(read(f))
            except Exception:
                continue
            for server in sorted(data):
                rows.append(["(harness)", server])
        return headers, rows

    if kind == "tools":
        headers = ["Module", "Tool", "Description"]
        rows = []
        # Tools are PROJECT-materialized (.agents/tools in the current project),
        # unlike commands/agents/skills/hooks/mcps which list module definitions
        # from the install. Passed from the shell as the project tools dir.
        tools_dir = sys.argv[4] if len(sys.argv) > 4 else os.path.join(os.getcwd(), ".agents", "tools")
        for f in sorted(glob.glob(os.path.join(tools_dir, "*.mcp.sh"))):
            name = os.path.basename(f)
            if name.endswith(".mcp.sh"):
                name = name[:-7]
            target = os.path.realpath(f)
            if not os.path.exists(target):
                continue
            desc = parse_tool_description(read(target))
            rows.append([module_of(target), name, desc])
        return headers, rows

    raise SystemExit("unknown type: %s" % kind)

headers, all_rows = collect(kind)
rows = [r for r in all_rows if r[0] not in disabled]

def sort_key(row):
    module = row[0]
    name = row[1]
    type_rank = 1
    if "Type" in headers:
        type_rank = 0 if row[headers.index("Type")] == "primary" else 1
    return (module, type_rank, name)

rows.sort(key=sort_key)

widths = []
for idx, h in enumerate(headers):
    widths.append(max([display_width(h)] + [display_width(r[idx]) for r in rows]))

def fmt(cells):
    return "| " + " | ".join(pad(c, w) for c, w in zip(cells, widths)) + " |"

print(fmt(headers))
print("| " + " | ".join("-" * w for w in widths) + " |")
for r in rows:
    cells = [c.replace("|", "\\|") for c in r]
    print(fmt(cells))
PY
}

cmd_init() {
  if [[ ! -f "${DEV_BOT_ROOT}/bin/init.sh" ]]; then
    echo "Error: bin/init.sh not found at ${DEV_BOT_ROOT}/bin/init.sh" >&2
    exit 1
  fi

  export DEV_BOT_ROOT
  exec bash "${DEV_BOT_ROOT}/bin/init.sh" "$@"
}

cmd_reinit() {
  if [[ ! -f "${DEV_BOT_ROOT}/bin/reinit.sh" ]]; then
    echo "Error: bin/reinit.sh not found at ${DEV_BOT_ROOT}/bin/reinit.sh" >&2
    exit 1
  fi

  export DEV_BOT_ROOT
  exec bash "${DEV_BOT_ROOT}/bin/reinit.sh" "$@"
}

cmd_up() {
  if [[ ! -f "${DEV_BOT_ROOT}/bin/up.sh" ]]; then
    echo "Error: bin/up.sh not found at ${DEV_BOT_ROOT}/bin/up.sh" >&2
    exit 1
  fi

  export DEV_BOT_ROOT
  exec bash "${DEV_BOT_ROOT}/bin/up.sh" "$@"
}

cmd_down() {
  if [[ ! -f "${DEV_BOT_ROOT}/bin/down.sh" ]]; then
    echo "Error: bin/down.sh not found at ${DEV_BOT_ROOT}/bin/down.sh" >&2
    exit 1
  fi

  export DEV_BOT_ROOT
  exec bash "${DEV_BOT_ROOT}/bin/down.sh" "$@"
}

cmd_prune() {
  if [[ ! -f "${DEV_BOT_ROOT}/bin/prune.sh" ]]; then
    echo "Error: bin/prune.sh not found at ${DEV_BOT_ROOT}/bin/prune.sh" >&2
    exit 1
  fi

  export DEV_BOT_ROOT
  exec bash "${DEV_BOT_ROOT}/bin/prune.sh" "$@"
}

cmd_stats() {
  if [[ ! -f "${DEV_BOT_ROOT}/bin/stats.sh" ]]; then
    echo "Error: bin/stats.sh not found at ${DEV_BOT_ROOT}/bin/stats.sh" >&2
    exit 1
  fi

  export DEV_BOT_ROOT
  exec bash "${DEV_BOT_ROOT}/bin/stats.sh" "$@"
}

  cmd_module() {
    local tool_script="${DEV_BOT_ROOT}/src/tools/external-modules/tools/module.sh"
    if [[ ! -f "$tool_script" ]]; then
      echo "Error: module tool not found" >&2
      exit 1
    fi
    exec bash "$tool_script" "$@"
  }

cmd_harness() {
  if [[ ! -f "$(pwd)/.devbot.project.jsonc" ]]; then
    cmd_help
    return
  fi

  # Bring the install to the newest release before wiring/up. Non-fatal: an
  # offline or conflicting update must never block the start, and update.sh is
  # a clean no-op when already on the newest release. The `version` it writes
  # changes the project's wiring hash, so the reinit just below picks it up.
  _devbot_auto_update_if_enabled

  # If the global or project config changed since the last wiring, reinit
  # BEFORE up.sh so the whole start sequence runs on up-to-date state (e.g.
  # docker services or up-scripts that depend on the new config). A failed
  # reinit asks whether to continue the start anyway.
  if ! _devbot_auto_reinit_if_config_changed "$(pwd)"; then
    _fatal "Start aborted — fix the reinit failure, or run 'devbot init' manually."
    exit 1
  fi

  # Register this session BEFORE up.sh so a concurrent last-exit teardown
  # cannot race the containers this session is about to use. Release runs on
  # normal exit AND on INT/TERM (Ctrl-C, kill) — EXIT alone does not fire on
  # SIGINT. When the last session releases, the devbot containers are removed.
  _devbot_session_register
  trap '_devbot_session_release' INT TERM EXIT

  bash "${DEV_BOT_ROOT}/bin/up.sh" "$(pwd)" || exit $?
  local harness
  harness="$(_devbot_get_harness "$(pwd)")"

  # Harness-arg passthrough: `devbot ... -- arg-X` forwards only the tail
  # after the first `--` to the harness (pre-`--` args are devbot's own and
  # are consumed). No `--` → all args forward unchanged. Args keep their
  # boundaries — assembled into an argv array via while-read (bash 3.2-safe).
  local -a harness_args=()
  local passthrough_arg
  while IFS= read -r passthrough_arg; do
    harness_args+=("${passthrough_arg}")
  done < <(_devbot_passthrough_args "$@")

  # Run the harness as a child (not exec) so the EXIT/INT/TERM trap can
  # release the session after it returns; preserve the harness exit code.
  local harness_exit=0
  bash "${DEV_BOT_ROOT}/src/harnesses/${harness}/start.sh" "$(pwd)" "${harness_args[@]}" || harness_exit=$?

  _devbot_session_release
  exit "${harness_exit}"
}

# ── main ──────────────────────────────────────────────────────────────────────

main() {
  local cmd="${1:-}"

  case "${cmd}" in
    "")
      cmd_harness
      ;;
    version|-V|--version)
      # Print the dev-bot version WITHOUT running the harness up-flow (the
      # bare `devbot`/unknown args fall through to cmd_harness).
      local devbot_ver
      if git -C "${DEV_BOT_ROOT}" rev-parse --short HEAD >/dev/null 2>&1; then
        devbot_ver="$(git -C "${DEV_BOT_ROOT}" rev-parse --short HEAD)"
      else
        devbot_ver="unknown"
      fi
      echo "dev-bot ${devbot_ver}"
      ;;
    help|-h|--help)
      cmd_help
      ;;
    install)
      cmd_install
      ;;
    update)
      shift
      cmd_update "$@"
      ;;
    models)
      shift
      cmd_models "$@"
      ;;
    tool)
      shift
      cmd_tool "$@"
      ;;
    list)
      shift
      cmd_list "$@"
      ;;
    init)
      shift
      cmd_init "$@"
      ;;
    reinit)
      shift
      cmd_reinit "$@"
      ;;
    up)
      shift
      cmd_up "$@"
      ;;
    down)
      cmd_down "$@"
      ;;
    prune)
      shift
      cmd_prune "$@"
      ;;
    stats)
      shift
      cmd_stats "$@"
      ;;
    module)
      shift
      cmd_module "$@"
      ;;
    *)
      cmd_harness "$@"
      ;;
  esac
}

main "$@"
