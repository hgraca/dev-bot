{
  "harness": "opencode", // decides what harness is used when launching `devbot`
  "gpu_enabled": false,
  "devbot_dir": ".agents",
  "commit_memory": false,
  "ollama_local_api": "http://localhost:18434",
  "modules": {
    "claudecode": false,
    "litellm": false,
    "react": false,
    "signoz": false,
    "svelte": false
  },
  "auto_recover": {
    "max_attempts": 5
  },
  "projects": [],
  "guards": [
    {
      "regex": "rm -rf",
      "message": "rm -rf is blocked"
    },
    {
      "regex": "sudo .*",
      "message": "sudo requires approval"
    },
    {
      "regex": "git push --force",
      "message": "force push is prohibited"
    }
  ],
  "external_modules": {
    "addyosmani": {
      "url": "https://github.com/addyosmani/agent-skills.git",
      "paths": {
        "agents": "agents",
        "skills": "skills"
      }
    },
    "mindrally-svelte": {
      "url": "https://github.com/mindrally/skills.git",
      "paths": {
        "skills": "svelte"
      }
    },
    "sveltekit-structure": {
      "url": "https://github.com/spences10/svelte-skills-kit.git",
      "paths": {
        "skills": "plugins/svelte-skills/skills/sveltekit-structure"
      }
    },
    "svelte5-best-practices": {
      "url": "https://github.com/ejirocodes/agent-skills.git",
      "paths": {
        "skills": "svelte/skills/svelte5-best-practices"
      }
    },
    "mindrally-react": {
      "url": "https://github.com/mindrally/skills.git",
      "paths": {
        "skills": "react"
      }
    },
    "mindrally-nextjs": {
      "url": "https://github.com/mindrally/skills.git",
      "paths": {
        "skills": "nextjs-react-typescript"
      }
    },
    "mindrally-react-best-practices": {
      "url": "https://github.com/mindrally/skills.git",
      "paths": {
        "skills": "modern-web-development"
      }
    },
    "mattpocock-grilling": {
      "url": "https://github.com/mattpocock/skills.git",
      "paths": {
        "skills": "skills/productivity/grilling"
      }
    }
  }
}
