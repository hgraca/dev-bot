{
  "version": "", // installed release tag — set by `devbot update`; a change triggers a per-project reinit on next start
  "auto_update": true, // run `devbot update` automatically on a bare `devbot` start
  "harness": "opencode", // decides what harness is used when launching `devbot`
  "gpu_enabled": false,
  "devbot_dir": ".agents",
  "commit_memory": false,
  "workflow": "worktrees", // worktrees | trunk — how a task is carried end to end; see the Workflows section of the software-development skill
  "ollama_local_api": "http://localhost:18434", // Ollama API endpoint for model pulls; read only by the codebase-index engine — inert when another codebase engine is selected
  "codebase_index_provider": "codebase-memory", // codebase-index | codebase-memory (absent => codebase-memory); pin "codebase-index" to keep the Ollama-based engine
  "memory_search_provider": "mdctx", // qmd | mdctx (absent => mdctx); pin "qmd" to keep the semantic/GPU engine
  "modules": {
    "atlassian": false,
    "aws": false,
    "claudecode": false,
    "frontend": false,
    "jetbrains": false,
    "litellm": false,
    "notion": false,
    "ollama": false,
    "react": false,
    "rfp": false,
    "sentry": false,
    "signoz": false,
    "sonarqube": false,
    "svelte": false
  },
  "auto_recover": {
    "max_attempts": 5
  },
  "projects": [],
  // Data sources offered to agents, through the shared MCP Toolbox gateway.
  // Declared once here; each project opts in by NAME in .devbot.project.jsonc.
  // Every value is either a literal or a "${VAR}" reference to an environment
  // variable — put a secret behind a reference and it exists in no file at
  // all. See docs/configuration.md.
  // Example:
  // "datasources": {
  //   "hotels-dev": {
  //     "type": "mysql",
  //     "env": {
  //       "MYSQL_HOST": "localhost",
  //       "MYSQL_USER": "root",
  //       "MYSQL_PASSWORD": "${HOTELS_DEV_DB_PASSWORD}"
  //     }
  //   }
  // },
  "datasources": {},
  // Cluster access for agents, rendered by src/agentic/k8s/init.sh into
  // ~/.kube/devbot.yaml plus an exec credential wrapper and ~/.kube/devbot.env.
  // Credential values stay in the environment: a value must be a "${VAR}"
  // reference, never the secret itself. See the `kubectl` section of
  // docs/configuration.md.
  // Example:
  // "kubectl": {
  //   "profile": "devbot-agent",
  //   "credential_env": {
  //     "AWS_ACCESS_KEY_ID": "${AWS_KEY}",
  //     "AWS_SECRET_ACCESS_KEY": "${AWS_SECRET}"
  //   },
  //   "clusters": [
  //     { "name": "k8s-prod", "context": "k8s-prod-ro", "region": "eu-central-1" },
  //     { "name": "k8s-stg", "context": "k8s-stg-rw", "region": "eu-central-1" }
  //   ]
  // },
  "kubectl": {},
  // AWS role connections offered to agents. Declared once here, so the key
  // always exists: reconciliation removes runtime keys the dist lacks, and a
  // machine that declared connections would lose them on `devbot update`.
  // The `aws` module must be enabled (`modules.aws: true`): a disabled
  // module's init never runs, so this catalogue alone wires no server.
  // Each project opts in by NAME in .devbot.project.jsonc. A connection is a
  // region plus "env" or "profile", and an optional account_id; credential
  // values are "${VAR}" references, as in a datasource.
  // Example:
  // "aws_connections": {
  //   "aws-prod-ro": {
  //     "region": "eu-central-1",
  //     "account_id": "123456789012",
  //     "env": {
  //       "AWS_ACCESS_KEY_ID": "${AWS_KEY}",
  //       "AWS_SECRET_ACCESS_KEY": "${AWS_SECRET}"
  //     }
  //   }
  // },
  "aws_connections": {},
  "guards": [
    {
      "regex": "rm -rf",
      "message": "rm -rf is blocked"
    },
    {
      "regex": "sudo .*",
      "message": "sudo is blocked"
    },
    {
      "regex": "(?<![*\\w])qmd(?![*\\w])",
      "message": "qmd is BM25-only and not agent-invokable — use the search-memories tool for memory recall."
    }
  ],
  "external_modules": {
    "addyosmani": {
      "url": "https://github.com/addyosmani/agent-skills.git",
      "paths": {
        "agents": "agents",
        "skills": "skills"
      }
    },
    "mindrally-svelte": {
      "url": "https://github.com/mindrally/skills.git",
      "paths": {
        "skills": "svelte"
      }
    },
    "sveltekit-structure": {
      "url": "https://github.com/spences10/svelte-skills-kit.git",
      "paths": {
        "skills": "plugins/svelte-skills/skills/sveltekit-structure"
      }
    },
    "svelte5-best-practices": {
      "url": "https://github.com/ejirocodes/agent-skills.git",
      "paths": {
        "skills": "svelte/skills/svelte5-best-practices"
      }
    },
    "mindrally-react": {
      "url": "https://github.com/mindrally/skills.git",
      "paths": {
        "skills": "react"
      }
    },
    "mindrally-nextjs": {
      "url": "https://github.com/mindrally/skills.git",
      "paths": {
        "skills": "nextjs-react-typescript"
      }
    },
    "mindrally-react-best-practices": {
      "url": "https://github.com/mindrally/skills.git",
      "paths": {
        "skills": "modern-web-development"
      }
    },
    "mattpocock-grilling": {
      "url": "https://github.com/mattpocock/skills.git",
      "paths": {
        "skills": "skills/productivity/grilling"
      }
    }
  }
}
