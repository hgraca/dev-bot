{
  "version": "", // installed release tag — set by `devbot update`; a change triggers a per-project reinit on next start
  "auto_update": true, // run `devbot update` automatically on a bare `devbot` start
  "harness": "opencode", // decides what harness is used when launching `devbot`; also the only harness enablement switch
  "gpu_enabled": false,
  "devbot_dir": ".agents",
  // Workspace behaviour defaults, applied to every project that does not
  // override them in its own config. `type`: repo | polyrepo — a polyrepo
  // orchestrates work and memory across the projects registered below.
  "workspace": {
    "type": "repo",
    "commit_memory": false,
    "workflow": "worktrees" // worktrees | trunk — how a task is carried end to end; see the Workflows section of the software-development skill
  },
  "ollama_local_api": "http://localhost:18434", // Ollama API endpoint for model pulls; read only by the codebase-index engine — inert when another codebase engine is selected
  "codebase_index_provider": "codebase-memory", // codebase-index | codebase-memory (absent => codebase-memory); pin "codebase-index" to keep the Ollama-based engine
  "memory_search_provider": "mdctx", // qmd | mdctx (absent => mdctx); pin "qmd" to keep the semantic/GPU engine
  // Per-module enablement. Harnesses are not toggled here: the root `harness`
  // key alone decides which one is wired, and a harness name in this map is
  // silently ignored.
  "modules": {
    "atlassian": false,
    "aws": false,
    "figma": false,
    "frontend": false,
    "jetbrains": false,
    "litellm": false,
    "netsuite": false,
    "notion": false,
    "ollama": false,
    "react": false,
    "rfp": false,
    "sentry": false,
    "signoz": false,
    "sonarqube": false,
    "svelte": false
  },
  "auto_recover": {
    "max_attempts": 5
  },
  "projects": [],
  // Data sources offered to agents, through the shared MCP Toolbox gateway.
  // Declared once here; each project opts in by NAME in .devbot.project.jsonc.
  // Every value is either a literal or a "${VAR}" reference to an environment
  // variable — put a secret behind a reference and it exists in no file at
  // all. See docs/configuration.md.
  // Example:
  // "datasources": {
  //   "hotels-dev": {
  //     "type": "mysql",
  //     "env": {
  //       "MYSQL_HOST": "localhost",
  //       "MYSQL_USER": "root",
  //       "MYSQL_PASSWORD": "${HOTELS_DEV_DB_PASSWORD}"
  //     }
  //   }
  // },
  "datasources": {},
  // Cluster access for agents, rendered by src/agentic/k8s/init.sh into
  // ~/.kube/devbot.yaml plus an exec credential wrapper and ~/.kube/devbot.env.
  // Credential values stay in the environment: a value must be a "${VAR}"
  // reference, never the secret itself. See the `kubectl` section of
  // docs/configuration.md.
  // Example:
  // "kubectl": {
  //   "profile": "devbot-agent",
  //   "credential_env": {
  //     "AWS_ACCESS_KEY_ID": "${AWS_KEY}",
  //     "AWS_SECRET_ACCESS_KEY": "${AWS_SECRET}"
  //   },
  //   "clusters": [
  //     { "name": "k8s-prod", "context": "k8s-prod-ro", "region": "eu-central-1" },
  //     { "name": "k8s-stg", "context": "k8s-stg-rw", "region": "eu-central-1" }
  //   ]
  // },
  "kubectl": {},
  // AWS role connections offered to agents. Declared once here, so the key
  // always exists: reconciliation removes runtime keys the dist lacks, and a
  // machine that declared connections would lose them on `devbot update`.
  // The `aws` module must be enabled (`modules.aws: true`): a disabled
  // module's init never runs, so this catalogue alone wires no server.
  // Each project opts in by NAME in .devbot.project.jsonc. A connection is a
  // region plus "env" or "profile", and an optional account_id; credential
  // values are "${VAR}" references, as in a datasource.
  // Example:
  // "aws_connections": {
  //   "aws-prod-ro": {
  //     "region": "eu-central-1",
  //     "account_id": "123456789012",
  //     "env": {
  //       "AWS_ACCESS_KEY_ID": "${AWS_KEY}",
  //       "AWS_SECRET_ACCESS_KEY": "${AWS_SECRET}"
  //     }
  //   }
  // },
  "aws_connections": {},
  // AutoBot profiles: declare a configuration once here, then name it from a project's
  // .devbot.project.jsonc (`"autobot": "gete-jira"`) — or configure that project inline instead.
  // "autobot": {
  //   "gete-jira": {
  //     "poll_jira": true,
  //     "poll_github": true,
  //     "jira_base_url": "https://getinfo.atlassian.net",
  //     "jira_email": "you@example.com",
  //     "jira_api_token": "${JIRA_API_TOKEN}",
  //     "jira_assignees": ["you@example.com"], // or [] to pick up nothing
  //     "poll_slack": true,
  //     "slack_user_email": "you@example.com",
  //     "slack_bot_token": "${SLACK_BOT_TOKEN}",
  //     "prompts": []
  //   }
  // },
  "autobot": {},
  // NetSuite MCP connection. `account_id` is the NetSuite account the project
  // connects as; the module ships enabled and registers a `netsuite-<account>`
  // server disabled by default (set `enabled: true` to wire it on). A project
  // value overrides this global one.
  // Example:
  // "netsuite": { "account_id": "1234567", "enabled": true },
  "netsuite": {},
  "guards": [
    {
      "regex": "rm -rf",
      "message": "rm -rf is blocked"
    },
    {
      "regex": "sudo .*",
      "message": "sudo is blocked"
    },
    {
      // Cluster access is MCP-only: each cluster is a `kctl-<cluster>` server
      // whose `kubectl` tool applies the project's kubeconfig and that
      // cluster's context. The leading group catches `VAR=x kubectl ...`.
      "regex": "(?:[A-Za-z_][A-Za-z0-9_]*=\\S*\\s+)*(?:\\S*/)?kubectl(?:\\s|$)",
      "message": "kubectl is blocked — use the kctl-<cluster> MCP server (its single `kubectl` tool takes kubectl's own args) instead of running kubectl in a shell. The module's memory has the rules."
    },
    {
      // The CLI runs kubectl too, so a shell call to it is the same bypass —
      // `env` and `contexts` stay available, they only print paths.
      "regex": "(?:[A-Za-z_][A-Za-z0-9_]*=\\S*\\s+)*(?:\\S*/)?devbot\\s+kctl\\s+(?:run|exec)\\b",
      "message": "devbot kctl run/exec is blocked for agents — use the kctl-<cluster> MCP server. `devbot kctl env|contexts` still prints the kubeconfig and the cluster list."
    },
    {
      "regex": "(?<![*\\w])qmd(?![*\\w])",
      "message": "qmd is BM25-only and not agent-invokable — use the search-memories tool for memory recall."
    }
  ],
  "external_modules": {
    "addyosmani": {
      "url": "https://github.com/addyosmani/agent-skills.git",
      "paths": {
        "agents": "agents",
        "skills": "skills"
      }
    },
    "mindrally-svelte": {
      "url": "https://github.com/mindrally/skills.git",
      "paths": {
        "skills": "svelte"
      }
    },
    "sveltekit-structure": {
      "url": "https://github.com/spences10/svelte-skills-kit.git",
      "paths": {
        "skills": "plugins/svelte-skills/skills/sveltekit-structure"
      }
    },
    "svelte5-best-practices": {
      "url": "https://github.com/ejirocodes/agent-skills.git",
      "paths": {
        "skills": "svelte/skills/svelte5-best-practices"
      }
    },
    "mindrally-react": {
      "url": "https://github.com/mindrally/skills.git",
      "paths": {
        "skills": "react"
      }
    },
    "mindrally-nextjs": {
      "url": "https://github.com/mindrally/skills.git",
      "paths": {
        "skills": "nextjs-react-typescript"
      }
    },
    "mindrally-react-best-practices": {
      "url": "https://github.com/mindrally/skills.git",
      "paths": {
        "skills": "modern-web-development"
      }
    },
    "mattpocock-grilling": {
      "url": "https://github.com/mattpocock/skills.git",
      "paths": {
        "skills": "skills/productivity/grilling"
      }
    }
  }
}
